# ==========================================================
# MEETFAME BACKEND ENVIRONMENT TEMPLATE
# ==========================================================

PORT=5001
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/meetfame?retryWrites=true&w=majority

# Vercel Blob Read/Write Storage Token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx

# JWT Authentication Secret
JWT_SECRET=your_custom_secure_jwt_secret_key_here

# Client URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGIN=*

# WebRTC relay (recommended for calls across different networks).
# Multiple TURN URLs may be comma-separated. Use dedicated relay credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
