# ==========================================================
# MEETFAME BACKEND ENVIRONMENT TEMPLATE
# ==========================================================

PORT=5001
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/meetfame?retryWrites=true&w=majority

# Vercel Blob Read/Write Storage Token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx

# JWT Authentication Secret
JWT_SECRET=your_custom_secure_jwt_secret_key_here

# Client URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGIN=*

# WebRTC relay (recommended for calls across different networks).
# Multiple TURN URLs may be comma-separated. Use dedicated relay credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Razorpay (backend only; never use a VITE_ prefix for secrets)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Password recovery email (backend only; use a verified Resend sender)
RESEND_API_KEY=
PASSWORD_RESET_FROM=MeetFame <no-reply@your-verified-domain.com>
# TEMPORARY TESTING ONLY: set to 1111 to allow the fixed OTP in production.
PASSWORD_RESET_TEST_OTP=
# Public site URL; use https://meet-fame.vercel.app in Vercel production
PASSWORD_RESET_BASE_URL=http://localhost:5173
# Include /admin/ in production: https://meet-fame.vercel.app/admin/
PASSWORD_RESET_ADMIN_BASE_URL=http://localhost:5174/
